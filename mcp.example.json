{
  "servers": {
    "Fystack MCP Server": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "~/fystack/mpcium-mcp-server/src/index.ts"
      ],
      "env": {
        "FYSTACK_API_KEY": "YOUR_API_KEY_HERE",
        "FYSTACK_API_SECRET": "YOUR_API_SECRET_HERE",
        "FYSTACK_ENVIRONMENT": "sandbox",
        "SOLANA_RPC_URL": "https://api.devnet.solana.com",
        "ETHEREUM_RPC_URL": "https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY",
        "ETHEREUM_CHAIN_ID": "11155111",
        "LOG_LEVEL": "info"
      }
    }
  }
}
